APP_NAME=skeleton
APP_ENV=dev

# AES-256-GCM 主密钥，base64 编码的 32 字节随机数：openssl rand -base64 32
APP_ENCRYPTION_KEY=

# 商户管理后台登录态 JWT（HS256）签名密钥，十六进制编码的 32 字节随机数：
# 用 `bin2hex(random_bytes(32))` 生成
MERCHANT_JWT_SECRET=

# 系统管理后台（web/admin）登录态 JWT（HS256）签名密钥，跟 MERCHANT_JWT_SECRET 是完全独立的两个值——
# 这是防止商户 token 被拿去当管理员 token 用（反之亦然）的真正隔离机制，不同签名密钥意味着
# 一方签发的 token 永远不能通过另一方的验签。十六进制编码的 32 字节随机数：
# 用 `bin2hex(random_bytes(32))` 生成
ADMIN_JWT_SECRET=

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0